---
import Icon from './Icon.astro';
import { site } from '../data/site';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const interests = [
  'Desarrollo de software a medida',
  'Sistema de Gestión Empresaria (Si.Ge.Em.)',
  'Sistema de Salud',
  'Soporte técnico y mantenimiento',
  'Redes y equipamiento',
  'Otro',
];
const field =
  'mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-ink-900 placeholder:text-slate-400 transition focus:border-brand-500 focus:outline-none focus:ring-4 focus:ring-brand-500/15';
---

<section id="contacto" class="section bg-white">
  <div class="container-x grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
    <div>
      <p class="eyebrow reveal">Contacto</p>
      <h2 class="reveal mt-4 text-3xl font-extrabold sm:text-5xl" style="--d: 70ms">
        Conversemos sobre su próximo proyecto.
      </h2>
      <p class="reveal mt-5 text-lg text-slate-600" style="--d: 140ms">
        Cuéntenos qué necesita y le responderemos a la brevedad para coordinar una reunión.
      </p>

      <ul class="reveal mt-10 space-y-6" style="--d: 200ms">
        <li class="flex gap-4">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-ink-900 text-white">
            <Icon name="pin" class="h-5 w-5" />
          </span>
          <div>
            <p class="font-bold text-ink-900">Oficinas</p>
            <p class="text-slate-600">
              {site.address.street} ({site.address.zip})<br />{site.address.city}
            </p>
            <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-sm font-semibold text-brand-600 hover:underline">
              Ver en el mapa
            </a>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-ink-900 text-white">
            <Icon name="phone" class="h-5 w-5" />
          </span>
          <div>
            <p class="font-bold text-ink-900">Teléfono y WhatsApp</p>
            <a href={`tel:${site.phones[0].href}`} class="text-slate-600 hover:text-brand-600">
              {site.phones[0].label}
            </a>
            <br />
            <a
              href={`https://wa.me/${site.whatsapp.href}?text=${encodeURIComponent(site.whatsapp.message)}`}
              target="_blank"
              rel="noopener"
              class="text-sm font-semibold text-brand-600 hover:underline"
            >
              Escribir por WhatsApp
            </a>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-ink-900 text-white">
            <Icon name="mail" class="h-5 w-5" />
          </span>
          <div>
            <p class="font-bold text-ink-900">Correo electrónico</p>
            <a href={`mailto:${site.email}`} class="text-slate-600 hover:text-brand-600">{site.email}</a>
          </div>
        </li>
      </ul>
    </div>

    <form
      id="contact-form"
      class="reveal rounded-3xl bg-slate-50 p-6 ring-1 ring-slate-200 sm:p-10"
      style="--d: 120ms"
      data-endpoint={endpoint}
      data-email={site.email}
      novalidate
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block text-sm font-semibold text-ink-900">
          Nombre y apellido
          <input class={field} type="text" name="nombre" autocomplete="name" required />
        </label>
        <label class="block text-sm font-semibold text-ink-900">
          Empresa / Institución
          <input class={field} type="text" name="empresa" autocomplete="organization" />
        </label>
        <label class="block text-sm font-semibold text-ink-900">
          Correo electrónico
          <input class={field} type="email" name="email" autocomplete="email" required />
        </label>
        <label class="block text-sm font-semibold text-ink-900">
          Teléfono
          <input class={field} type="tel" name="telefono" autocomplete="tel" />
        </label>
      </div>
      <label class="mt-5 block text-sm font-semibold text-ink-900">
        ¿Qué le interesa?
        <select class={field} name="interes">
          {interests.map((i) => <option>{i}</option>)}
        </select>
      </label>
      <label class="mt-5 block text-sm font-semibold text-ink-900">
        Mensaje
        <textarea class={field} name="mensaje" rows="5" required></textarea>
      </label>
      <!-- Anti-spam: campo trampa oculto -->
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <button type="submit" class="btn btn-primary mt-7 w-full sm:w-auto">
        Enviar consulta <Icon name="arrow" class="h-4 w-4" />
      </button>
      <p id="form-status" class="mt-4 min-h-6 text-sm" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (data.website) return; // bot

    if (!data.nombre?.trim() || !data.email?.includes('@') || !data.mensaje?.trim()) {
      status.className = 'mt-4 min-h-6 text-sm text-brand-600';
      status.textContent = 'Por favor complete nombre, correo y mensaje.';
      return;
    }

    const endpoint = form.dataset.endpoint;
    if (endpoint) {
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error();
        form.reset();
        status.className = 'mt-4 min-h-6 text-sm text-emerald-700';
        status.textContent = '¡Gracias! Recibimos su consulta y nos pondremos en contacto a la brevedad.';
      } catch {
        status.className = 'mt-4 min-h-6 text-sm text-brand-600';
        status.textContent = 'No pudimos enviar el mensaje. Escríbanos a ' + form.dataset.email + '.';
      }
      return;
    }

    // Sin endpoint configurado: abre el correo del visitante con el mensaje armado
    const body = [
      `Nombre: ${data.nombre}`,
      `Empresa: ${data.empresa || '-'}`,
      `Teléfono: ${data.telefono || '-'}`,
      `Interés: ${data.interes}`,
      '',
      data.mensaje,
    ].join('\n');
    window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(
      'Consulta desde la web - ' + data.nombre
    )}&body=${encodeURIComponent(body)}`;
  });
</script>
