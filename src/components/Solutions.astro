---
import Icon from './Icon.astro';
import { solutions } from '../data/content';
---

<section id="soluciones" class="section relative overflow-hidden bg-ink-900 text-slate-300">
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-[32rem] w-[32rem] rounded-full bg-brand-500/15 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-x relative">
    <div class="max-w-2xl">
      <p class="eyebrow reveal !text-brand-400 before:!bg-brand-400">Soluciones</p>
      <h2 class="reveal mt-4 text-3xl font-extrabold !text-white sm:text-5xl" style="--d: 70ms">
        Sistemas modulares, listos para integrarse.
      </h2>
      <p class="reveal mt-5 text-lg text-slate-400" style="--d: 140ms">
        Cada módulo cubre un sector de la organización. Funcionan de forma autónoma o en conjunto,
        compartiendo y realimentando la información entre sí.
      </p>
    </div>

    <div class="mt-16 space-y-20">
      {
        solutions.map((sol) => (
          <article id={sol.id} class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
            <div class="reveal lg:sticky lg:top-28 lg:self-start">
              <span class="grid h-14 w-14 place-items-center rounded-2xl bg-brand-500 text-white shadow-lg shadow-brand-500/30">
                <Icon name={sol.icon} class="h-7 w-7" />
              </span>
              <p class="mt-6 text-sm font-semibold uppercase tracking-[0.18em] text-brand-400">
                {sol.kicker}
              </p>
              <h3 class="mt-2 text-3xl font-extrabold !text-white">{sol.title}</h3>
              <p class="mt-1 text-sm font-medium text-slate-400">{sol.audience}</p>
              <p class="mt-5 leading-relaxed text-slate-400">{sol.text}</p>
              <a
                href="#contacto"
                class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-white transition hover:gap-3"
              >
                Consultar por esta solución <Icon name="arrow" class="h-4 w-4 text-brand-400" />
              </a>
            </div>

            <ul class="grid gap-4 sm:grid-cols-2">
              {sol.modules.map((m, i) => (
                <li
                  class="reveal rounded-2xl bg-ink-800 p-6 ring-1 ring-white/5 transition hover:bg-ink-700 hover:ring-brand-500/40"
                  style={`--d:${(i % 2) * 80}ms`}
                >
                  <div class="flex items-center gap-2.5">
                    <span class="grid h-6 w-6 place-items-center rounded-full bg-brand-500/15 text-brand-400">
                      <Icon name="check" class="h-3.5 w-3.5" />
                    </span>
                    <h4 class="text-base font-bold !text-white">{m.name}</h4>
                  </div>
                  <p class="mt-3 text-sm leading-relaxed text-slate-400">{m.text}</p>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
