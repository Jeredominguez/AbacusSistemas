---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada | Abacus Sistemas S.R.L.">
  <main class="grid min-h-screen place-items-center bg-ink-900 px-6 text-center">
    <div>
      <p class="font-display text-8xl font-extrabold text-brand-500">404</p>
      <h1 class="mt-4 text-3xl font-extrabold !text-white">No encontramos la página</h1>
      <p class="mt-3 text-slate-400">Es posible que el enlace haya cambiado o ya no exista.</p>
      <a href="/" class="btn btn-primary mt-8">Volver al inicio</a>
    </div>
  </main>
</Layout>
